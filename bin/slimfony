#!/usr/bin/env php
<?php

declare(strict_types=1);

use Slimfony\Core\Build\Compiler;

foreach ([__DIR__ . '/../vendor/autoload.php', __DIR__ . '/../../../autoload.php'] as $autoload) {
    if (is_file($autoload)) {
        require $autoload;

        break;
    }
}

if (!class_exists(Compiler::class)) {
    fwrite(STDERR, "Composer autoloader not found. Run `composer install` first.\n");
    exit(1);
}

if (5 !== $argc || 'warmup' !== $argv[1]) {
    fwrite(STDERR, "Usage: slimfony warmup <services.php> <routes.php> <cache-dir>\n");
    exit(2);
}

try {
    Compiler::warmup($argv[2], $argv[3], $argv[4]);
} catch (Throwable $e) {
    fwrite(STDERR, 'Warmup failed: ' . $e->getMessage() . "\n");
    exit(1);
}

echo "Warmup done: {$argv[4]}\n";
