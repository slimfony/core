{
    "name": "slimfony/core",
    "description": "Ultra-lightweight, secure Symfony-component based microservice core for FrankenPHP worker mode.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "frankenphp",
        "worker",
        "microservice",
        "symfony",
        "dbal",
        "prometheus"
    ],
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "doctrine/dbal": "^4.5",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "php": "^8.4",
        "psr/log": "^3.0.2",
        "symfony/dependency-injection": "^8.1",
        "symfony/http-foundation": "^8.1",
        "symfony/routing": "^8.1",
        "symfony/service-contracts": "^3.8"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpunit/phpunit": "^13.4"
    },
    "suggest": {
        "ext-apcu": "Default shared metrics storage across FrankenPHP worker threads",
        "ext-pdo_pgsql": "PostgreSQL driver (recommended, tested in CI)"
    },
    "autoload": {
        "psr-4": {
            "Slimfony\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Slimfony\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse --memory-limit=512M",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "ci": [
            "@test",
            "@stan",
            "@cs"
        ]
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-mbstring": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php84": "*"
    },
    "support": {
        "issues": "https://github.com/er2es/slimfony/issues"
    }
}
